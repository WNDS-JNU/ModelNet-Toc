map $http_upgrade $connection_upgrade {
    default upgrade;
    '' close;
}

upstream toc_upstream {
    server 127.0.0.1:13081 max_fails=1 fail_timeout=10s;
    keepalive 32;
}

upstream dify_upstream {
    server 127.0.0.1:13080 max_fails=1 fail_timeout=10s;
    keepalive 32;
}

server {
    listen 80 default_server;
    listen [::]:80 default_server;
    server_name 123.56.135.150;

    client_max_body_size 100m;

    location ^~ /.well-known/acme-challenge/ {
        root /var/www/modelnet-acme;
        default_type text/plain;
        try_files $uri =404;
    }

    location / {
        proxy_pass http://toc_upstream;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-Host $host;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        proxy_read_timeout 3600s;
        proxy_send_timeout 3600s;
        proxy_redirect http://10.154.22.10:3081/ $scheme://$host/;
    }
}

server {
    listen 8080;
    listen [::]:8080;
    server_name _;

    client_max_body_size 100m;

    location / {
        proxy_pass http://dify_upstream;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-Host $host;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        proxy_read_timeout 3600s;
        proxy_send_timeout 3600s;
    }
}
