# ModelNet ToC pilot
MODELNET_APP_PORT=3081
MODELNET_APP_REPLICAS=1
MODELNET_APP_IMAGE=modelnet/modelnet-toc:2.2.0-modelnet
MODELNET_APP_SRC=./modelnet-app
APP_URL=http://YOUR_SERVER_IP:3081
INTERNAL_APP_URL=http://localhost:3210

# Generate with:
#   openssl rand -base64 32
KEY_VAULTS_SECRET=replace-with-random-base64
AUTH_SECRET=replace-with-random-base64

# Generate an RSA JWK for ModelNet auth. Do not commit production values.
JWKS_KEY={"keys":[]}

# Database
MODELNET_DB_NAME=modelnet
POSTGRES_PASSWORD=replace-with-random-password

# RustFS / S3-compatible storage
S3_ENDPOINT=http://YOUR_SERVER_IP:9100
RUSTFS_PORT=9100
RUSTFS_ADMIN_PORT=9101
RUSTFS_ACCESS_KEY=admin
RUSTFS_SECRET_KEY=replace-with-random-secret
MODELNET_STORAGE_BUCKET=modelnet

# ToC pilot defaults
AUTH_DISABLE_EMAIL_PASSWORD=0
ENABLED_OPENAI=1
ENABLED_MODELNET=1
ENABLED_OLLAMA=0

# ModelNet gateway
# MODELNET_BACKEND_API_KEY authenticates ModelNet App -> Router and is forwarded to backends; use "none" when auth is disabled.
# SILICONFLOW_API_KEY is used by default SiliconFlow free models in the dev ModelNet registry.
MODELNET_BACKEND_API_KEY=none
SILICONFLOW_API_KEY=replace-with-siliconflow-api-key

# Device Gateway (generate a distinct token for production and dev with openssl rand -hex 32)
DEVICE_GATEWAY_SERVICE_TOKEN=replace-with-random-64-hex-token
MODELNET_DEVICE_GATEWAY_HOST=127.0.0.1
MODELNET_DEVICE_GATEWAY_PORT=3093
DEV_MODELNET_DEVICE_GATEWAY_HOST=127.0.0.1
DEV_MODELNET_DEVICE_GATEWAY_PORT=3193

# Persist the new Agent Group Run/Node/Attempt projection. Keep disabled until
# the durable-run migration and dev recovery checks have passed.
AGENT_GROUP_DURABLE_RUNS=0
